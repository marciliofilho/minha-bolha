# -----------------------------------------------------------------------------
# Hub — variáveis de ambiente
# Copie este arquivo para ".env" se quiser usar o fallback por arquivo.
#
# As chaves de API podem ser salvas diretamente no app, em
# Configurações → Chaves de API. O valor salvo no app tem prioridade;
# este arquivo serve como fallback.
# NUNCA comite o .env.
# -----------------------------------------------------------------------------

# Porta do backend (o front de desenvolvimento roda em 5173 e faz proxy para cá)
PORT=4000

# Interface de rede. Mantenha 127.0.0.1 para uso apenas local.
# Use 0.0.0.0 somente se quiser abrir de outro dispositivo da sua rede.
# HOST=127.0.0.1

# Caminho do banco SQLite, relativo à raiz do projeto
HUB_DB_PATH=./data/hub.db

# Fuso horário usado para exibir datas
TZ=America/Sao_Paulo

# Cria fontes e itens fictícios no primeiro boot (útil para testar a interface).
# Defina como false quando for usar de verdade.
HUB_SEED_DEMO=true

# --- Fase 2: filmes e séries -------------------------------------------------
# https://www.themoviedb.org/settings/api  (chave "API Key" v3)
TMDB_API_KEY=

# --- Fase 3: jogos -----------------------------------------------------------
# A wishlist da Steam é lida pela API pública e NÃO exige chave.
# O monitoramento de preços usa a chave do gg.deals abaixo.

# Obrigatória para monitorar preços. https://gg.deals/api/ (plano gratuito,
# uso pessoal, com atribuição).
GGDEALS_API_KEY=

# --- Stremio -----------------------------------------------------------------
# No app empacotado, o Hub gera automaticamente uma chave em data/app-secret.
# Defina APP_SECRET só se quiser usar uma chave própria (mín. 16 caracteres).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Fallback opcional de torrents/HLS. O motor embutido (WebTorrent + FFmpeg)
# não depende do Stremio aberto; use isto só se quiser o servidor como reserva.
# STREMIO_SERVER_URL=http://127.0.0.1:11470

# --- Torrents (motor embutido) ----------------------------------------------
# Onde ficam os pedaços baixados e os segmentos HLS. Padrão: ./data/torrent-cache
# TORRENT_CACHE_DIR=./data/torrent-cache

# Binários usados pelo motor. Por padrão vêm de ffmpeg-static/ffprobe-static.
# FFMPEG_PATH=
# FFPROBE_PATH=

# --- Novels ------------------------------------------------------------------
# O Minha Bolha lê páginas de novels usando o Chromium do próprio Electron.
# Não é preciso instalar Edge/Chrome. A antiga HUB_BROWSER_PATH foi descontinuada.

